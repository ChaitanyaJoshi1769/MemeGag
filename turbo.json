{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "globalDependencies": ["**/.env.local", "**/.env"],
  "pipeline": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**"],
      "cache": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": true
    },
    "test:e2e": {
      "cache": false
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "cache": true
    },
    "type-check": {
      "cache": true
    },
    "lint": {
      "cache": true,
      "outputs": [".eslintcache"]
    },
    "clean": {
      "cache": false
    },
    "db:push": {
      "cache": false,
      "inputs": ["prisma/**"]
    },
    "db:migrate": {
      "cache": false,
      "inputs": ["prisma/**"]
    },
    "docker:build": {
      "dependsOn": ["build"],
      "cache": false
    },
    "docker:push": {
      "dependsOn": ["docker:build"],
      "cache": false
    },
    "deploy:staging": {
      "dependsOn": ["docker:push"],
      "cache": false
    },
    "deploy:prod": {
      "dependsOn": ["docker:push"],
      "cache": false
    }
  }
}

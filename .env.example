# Application
NODE_ENV=development
APP_NAME=MemeGag
APP_VERSION=0.1.0

# Server
API_HOST=0.0.0.0
API_PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/memegag
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_ENABLED=false

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=memegag-app
KAFKA_CONSUMER_GROUP=memegag-consumers

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
REFRESH_TOKEN_EXPIRATION=7d

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth - Discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# OAuth - Reddit
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# OAuth - Apple
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id

# AI Services
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=
ANTHROPIC_API_KEY=sk-ant-...
HUGGINGFACE_API_KEY=

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_BUCKET=memegag-media
CLOUDFRONT_DOMAIN=d12345.cloudfront.net

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Storage
STORAGE_PROVIDER=s3
MAX_FILE_SIZE=104857600

# Feature Flags
FEATURE_FLAGS_API_KEY=your-feature-flags-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email
EMAIL_PROVIDER=resend
SENDGRID_API_KEY=
RESEND_API_KEY=
MAILGUN_API_KEY=

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Monitoring
SENTRY_DSN=
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Media Processing
FFMPEG_PATH=ffmpeg
MAX_VIDEO_DURATION=3600
MAX_IMAGE_DIMENSION=8000

# Moderation
MODERATION_ENABLED=true
MODERATION_API_KEY=

# Analytics
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=memegag

{
  "name": "@memegag/realtime-service",
  "version": "0.1.0",
  "description": "Real-time WebSocket service",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "docker:build": "docker build -t memegag-realtime-service:latest .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
